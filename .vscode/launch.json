{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: GDB Launch (make)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bicycle", // <-- change to your executable
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "Make: build", // must match the task label in tasks.json
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
